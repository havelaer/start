generator client {
  provider    = "prisma-client"
  output      = "../src/.api/generated/prisma"
  engineType  = "client"
  importFileExtension = "js"
}

datasource db {
  provider    = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  password      String
  passwordSalt  String
  createdAt     DateTime @default(now())
}
